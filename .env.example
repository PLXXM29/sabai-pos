# Copy to .env for docker-compose. NEVER commit the real .env.

# ── Database ─────────────────────────────────────────────
POSTGRES_USER=sabai
POSTGRES_PASSWORD=change_me_dev_password
POSTGRES_DB=sabai

# ── App ──────────────────────────────────────────────────
APP_ENV=development
LOG_LEVEL=info
# Port published on the host by docker-compose.prod.yml.
WEB_PORT=8090

# ── Auth secrets (long random strings; >= 32 chars in production) ──
# Generate e.g.:  openssl rand -hex 32
JWT_ACCESS_SECRET=dev_access_secret_change_me_0123456789abcdef
JWT_REFRESH_SECRET=dev_refresh_secret_change_me_0123456789abcdef

# ── Demo mode ────────────────────────────────────────────
# ON  = fill an empty database with a month of sample trading, publish the
#       sample logins on the sign-in screen, and expose POST /api/v1/demo/reset.
# OFF = a real shop. Keep it off anywhere real money is counted.
# The dev compose file turns this on for you; production compose forces it off.
DEMO_MODE=true
# Rebuild the sample data on this interval (0 = never; the manual reset still
# works). 24h suits a shared public demo; 0 suits local development.
DEMO_RESET_EVERY=0

# ── Auto-confirm PromptPay (optional) ────────────────────
# Shared secret for the generic payment webhook (phone / Apps Script forwarder).
# Empty = /webhooks/payment disabled.
PAYMENT_NOTIFY_SECRET=dev_notify_secret_change_me
# LINE Official Account: channel secret verifies /webhooks/line signatures.
# Empty = LINE webhook disabled. Optional custom amount parser regex.
LINE_CHANNEL_SECRET=
LINE_AMOUNT_REGEX=

# ── Rarely changed ───────────────────────────────────────
# AUTO_MIGRATE=true     apply pending migrations on boot
# SERVE_UI=true         serve the embedded web app from the API binary
# CORS_ALLOWED_ORIGINS  only needed when the UI is served from another origin
