# Copy to .env for docker-compose. NEVER commit the real .env.
# ── Database ─────────────────────────────────────────────
POSTGRES_USER=minimart
POSTGRES_PASSWORD=change_me_dev_password
POSTGRES_DB=minimart

# ── App ──────────────────────────────────────────────────
APP_ENV=development
LOG_LEVEL=info
CORS_ALLOWED_ORIGINS=http://localhost:5173

# ── Auth secrets (use long random strings; >= 32 chars in production) ──
# Generate e.g.:  openssl rand -hex 32
JWT_ACCESS_SECRET=dev_access_secret_change_me_0123456789abcdef
JWT_REFRESH_SECRET=dev_refresh_secret_change_me_0123456789abcdef
