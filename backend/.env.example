# Backend env for running the API directly (go run ./cmd/api) without compose.
# With docker-compose these come from the root .env instead.
APP_ENV=development
HTTP_PORT=8080
LOG_LEVEL=info
DATABASE_URL=postgres://minimart:change_me_dev_password@localhost:5432/minimart?sslmode=disable
CORS_ALLOWED_ORIGINS=http://localhost:5173
JWT_ACCESS_SECRET=dev_access_secret_change_me_0123456789abcdef
JWT_REFRESH_SECRET=dev_refresh_secret_change_me_0123456789abcdef
